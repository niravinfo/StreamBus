<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>StreamBus</RootNamespace>
    <AssemblyName>StreamBus</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>StreamBus</PackageId>
    <!-- 0.2.0 is the shared-message-context breaking release; the published
         version comes from the release tag. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Nirav Patel</Authors>
    <Description>A modern .NET client for RabbitMQ Streams. Publish and consume typed messages, with retries and dead-lettering built in.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rabbitmq;rabbitmq-streams;streams;messaging;message-bus;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/niravinfo/StreamBus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/niravinfo/StreamBus</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NativeAOT/trimming is not a supported publish target yet: the default
         serializer is reflection-based System.Text.Json and configuration is
         type-based DI, so IsAotCompatible/IsTrimmable would surface warnings
         this library cannot fix today. The typed filter/context/consumer paths
         are annotated (RequiresUnreferencedCode / RequiresDynamicCode) and the
         UsePublishFilter<TFilter,TMessage> / UseConsumeFilter<TFilter,TMessage>
         overloads avoid runtime generic closing, so consumers can see where the
         dynamic paths are before a trim/AOT lane is enabled. -->
  </PropertyGroup>
  <!-- SourceLink: embeds repository URL + commit hash into the PDB so the
       snupkg symbols are source-indexed and traceable to the GitHub commit.
       DeterministicSourcePaths is required for portable, reproducible paths;
       EmbedUntrackedSources keeps the PDB self-contained about tracked files. -->
  <PropertyGroup>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RabbitMQ.Stream.Client" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
