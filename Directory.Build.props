<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Only src/StreamBus opts back in; examples and tests must never produce a package. -->
    <IsPackable>false</IsPackable>
    <!-- NuGet audit findings (new advisories, deprecations) are reported as warnings but
         must not fail an unrelated build; they are still visible in the CI log. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- CA1848/CA1873: the existing ILogger calls are guarded and cheap; converting
         every call site to LoggerMessage is a separate performance refactor.
         CA1001: StreamBusMetrics owns a process-lifetime static Meter by design.
         CA1068: the internal optional registrationName follows the
         cancellation token for positional call-site compatibility. CA1716: the v2 middleware contract
         pins the `next` continuation parameter and the header writer's `Set` verb. -->
    <NoWarn>$(NoWarn);CA1001;CA1068;CA1716;CA1848;CA1873</NoWarn>
    <!-- CA1711: test assemblies define xunit collection fixtures, whose names
         conventionally end in 'Collection'. The shipped library sets no such
         suppression; a public 'Delegate'/'Collection' name there must fail. -->
    <NoWarn Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', 'Tests$'))">$(NoWarn);CA1711</NoWarn>
    <!-- CA5397/SYSLIB0039/CS0618 (tests only): TLS options validation tests must
         name deprecated protocols (Ssl2, Ssl3, Tls 1.0, Tls 1.1) as theory data to
         assert they are rejected; naming them is exactly what these analyzers
         flag. The shipped library never references them: the insecure-protocol
         mask in StreamBusOptions.Validate is expressed numerically so the shipped
         assembly keeps the analyzers fully enforced. -->
    <NoWarn Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', 'Tests$'))">$(NoWarn);CA5397;SYSLIB0039;CS0618</NoWarn>
    <!-- xunit.v3 4.x sets IsTestingPlatformApplication transitively via xunit.v3.mtp-v2, whose MSBuild
         targets hard-error the VSTest target on .NET 10 SDK. False restores classic `dotnet test`
         (verified by isolated probe); inert for non-test projects. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
</Project>
