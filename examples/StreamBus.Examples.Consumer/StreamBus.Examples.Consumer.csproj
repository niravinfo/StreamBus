<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Opt out of the shared TargetFrameworks in Directory.Build.props: the
         examples are a deliberate net10 consumer canary. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>StreamBus.Examples.Consumer</RootNamespace>
    <!-- Top-level example programs intentionally declare sample records in the
         global namespace. -->
    <NoWarn>$(NoWarn);CA1050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/StreamBus/StreamBus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
